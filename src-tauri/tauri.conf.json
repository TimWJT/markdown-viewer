{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Viewer",
  "version": "1.1.0",
  "identifier": "com.markdownviewer.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost blob:; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Markdown Viewer",
        "width": 1100,
        "height": 820,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TimWJT/markdown-viewer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQTBGQjg2ODEzNjE1MjQKUldRa0ZUYUJodnVnc015S01XOUl3a0paRkl5NWdDSHRBMVdiMUxKTTZWZVFWSnhhNHJzYmpxSTcK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A markdown viewer that gets out of the way",
    "longDescription": "Opens markdown files, renders them well, and lets you zoom and pan. No editor, no vault, no plugins. Live-reloads while you edit the file elsewhere.",
    "category": "Utility",
    "copyright": "© 2026 Tim Wang",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdx"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "customLanguageFiles": { "English": "./nsis/English.nsh" },
        "startMenuFolder": "Markdown Viewer"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "publisher": "Tim Wang",
    "homepage": "https://github.com/TimWJT/markdown-viewer"
  }
}
