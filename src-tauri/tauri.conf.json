{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Viewer",
  "version": "1.0.0",
  "identifier": "com.markdownviewer.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost blob:; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Markdown Viewer",
        "width": 1100,
        "height": 820,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A markdown viewer that gets out of the way",
    "longDescription": "Opens markdown files, renders them well, and lets you zoom and pan. No editor, no vault, no plugins. Live-reloads while you edit the file elsewhere.",
    "category": "Utility",
    "copyright": "",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
