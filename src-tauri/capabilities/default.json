{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions the viewer window needs: the open dialog, window title updates, and the drag-drop / open-file events.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "dialog:allow-open",
    "opener:allow-open-url",
    "window-state:default"
  ]
}
